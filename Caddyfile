bot-finance-neto.duckdns.org {
    @minhasEconomias path /integracoes/minhas-economias/conectar /integracoes/minhas-economias/callback

    handle @minhasEconomias {
        reverse_proxy api:8000
    }

    handle {
        respond "Not Found" 404
    }
}

api.usefinanceai.com.br {
    reverse_proxy api:8000
}

app.usefinanceai.com.br {
    root * /srv/pwa
    encode gzip

    @noCache {
        path / /index.html /manifest.json
    }
    header @noCache Cache-Control "no-store, no-cache, must-revalidate"

    try_files {path} /index.html
    file_server
}

